{
  "name": "elden-ring-tracker",
  "version": "0.6.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "reuse:check": "bun run tools/check-reuse.ts",
    "catalogue": "bun run tools/build-catalogue.ts",
    "catalogue:check": "bun run tools/build-catalogue.ts --check",
    "places": "bun run tools/place-names-report.ts",
    "key-spots": "bun run tools/key-spots-report.ts",
    "bosses": "bun run tools/write-bosses.ts",
    "location-groups": "bun run tools/write-location-groups.ts",
    "region-graph": "bun run tools/write-region-graph.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run reuse:check && bun run catalogue:check"
  },
  "dependencies": {
    "immer": "11.2.9",
    "lit": "^3.3.3",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "archipelago.js": "2.1.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
